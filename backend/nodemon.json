{
  "watch": [
    "server.js",
    "config",
    "controllers",
    "middleware",
    "models",
    "repositories",
    "routes",
    "services",
    "utils",
    "data",
    "scripts"
  ],
  "ext": "js,json",
  "ignore": ["node_modules", "dist", ".env", "*.log"],
  "restartDelay": 500,
  "legacyWatch": true,
  "exitCrash": true
}
