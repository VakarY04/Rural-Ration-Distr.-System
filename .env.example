# ======================================================================
# E-Ration Portal — environment variable template
# ----------------------------------------------------------------------
# Copy the relevant section into a real `.env` file:
#   - backend/.env   → loaded automatically by the backend (dotenv)
#   - frontend/.env  → optional; only needed to override VITE_API_URL
#
# NEVER commit real `.env` files — they contain secrets.
# ======================================================================

# ------------------------------ BACKEND -------------------------------
# Server
PORT=5000
NODE_ENV=development

# Database
# DATA_SOURCE selects the booking repository strategy: MONGO (real DB) or MOCK (in-memory seed data for offline dev)
DATA_SOURCE=MONGO
MONGO_URI=your_mongodb_connection_string_here

# Auth — used to sign JWT session tokens. Use a long random string.
JWT_SECRET=your_jwt_secret_here

# AI grievance triage (Google Gemini). Leave empty to use the fallback ticket generator.
GEMINI_API_KEY=your_gemini_api_key_here

# Email (SMTP) — used by nodemailer to deliver phone-OTP codes
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Citizen feedback inbox — owner address receiving feedback copies.
# Defaults to EMAIL_USER when unset.
FEEDBACK_TO=your_email@gmail.com

# ----------------------------- FRONTEND -------------------------------
# Base URL of the backend API.
# Falls back to http://localhost:5000/api when unset.
VITE_API_URL=http://localhost:5000/api
